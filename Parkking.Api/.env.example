# Casilla SMTP única de Parkking (remitente de TODOS los mails de la app).
# Destinos: Cliente / Usuario / EmailAvisos del estacionamiento — nunca son From.
#
# Email__UserName / Email__FromEmail = la casilla Parkking (ej. parkking@gmail.com)
# Email__Password = App Password de Google (16 letras)

Email__Enabled=true
Email__Host=smtp.gmail.com
Email__Port=587
Email__UseSsl=true
Email__UserName=parkking@gmail.com
Email__Password=tuapppasswordsinespacios
Email__FromEmail=parkking@gmail.com
Email__FromName=Parkking
